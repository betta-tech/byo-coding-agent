# Compiled binaries (anchored to repo root so they don't match cmd/sitegen/ etc.)
/harness
/sitegen

# Runtime artifacts (compaction logs, etc.)
*.log

# Local MCP server config — may contain auth tokens. Track mcp.example.json instead.
mcp.json

# Agent memory store (chapter 19). May contain project paths, user names,
# or other context worth keeping local.
.harness/

# Background agents' git worktrees (one checkout per agent).
.worktrees/

# Generated static site (cmd/sitegen output). CI rebuilds and deploys it.
site/

# Editor / IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
